[
  {
    "id": "deploy",
    "execute-command": "/opt/tenerife-site/deploy/deploy.sh",
    "command-working-directory": "/opt/tenerife-site",
    "response-message": "Déploiement déclenché",
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "REPLACE_WITH_SECRET",
            "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "refs/heads/main",
            "parameter": { "source": "payload", "name": "ref" }
          }
        }
      ]
    }
  }
]
